[NAME]
name=xraygui

[VERSION]
version=2.7.1

[RELEASE]
release=0.mrx9

[GROUP]
group=Applications/System

[DESCRIPTION]
0=A small and nimble GUI for XRay-core
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2023

[SUMMARY]
summary=A small and nimble GUI for XRay-core

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/XRayGUI

[LICENSE]
license=GPLv3

[DEPS]
deps=systemd zenity curl p7zip qrencode libproxy1v5 libproxy1-plugin-gsettings libgtk2.0-0

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/share/xraygui/
1=/usr/share/doc/xraygui/
2=/usr/bin/xraygui
3=/usr/bin/xray-update
4=/usr/share/icons/xraygui.png
5=/etc/systemd/user/xray.service
6=/etc/systemd/user/xray-update.service
7=/usr/share/applications/xraygui.desktop

[AFTERINSTALL]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[AFTERREMOVE]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[BEFOREREMOVE]
0=#!/bin/bash
1=
2=#Окончательное удаление
3=if [ $1 -eq 0 ]; then
4=if [[ $(pidof xray) ]]; then killall xray; fi
5=systemctl daemon-reload
6=fi

[URL32]
url32=https://github.com/AKotov-dev/XRayGUI

[PROGRAMNAME]
programname=XRayGUI

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=v2.7.1
1=+ The project is temporarily frozen
2=+ Xray-core auto-update is disabled
3=+ Clients and servers are incompatible with the new Xray-core v26.1.31
4=+ Rollback: Xray-core v26.1.23
5=
6=To restore functionality Download/Install Xray-core v26.1.23 if it is not installed before (run as user)
7=```
8=killall xray; mkdir -p ~/.config/xraygui/xray; cd ~/.config/xraygui/xray; curl -OL https://github.com/XTLS/Xray-core/releases/download/v26.1.23/Xray-linux-64.zip; 7z e -y ./*.zip; rm -f ./*.zip*
9=```
10=**Note:** For more stable operation, it is recommended to consider other anonymization tools and protocols.
11=
12=v2.7
13=+ kwriteconfig5/6 support (KDE-5/6)
14=+ Added packages for Mageia 9/10 and Ubuntu
15=
16=V2.6
17=+ Recompiled using Lazarus 4.4
18=+ Enhanced system-wide proxy mode
19=+ Added packages for Mageia 9 and Ubuntu
20=
21=**Note:** Extended the list of supported desktop environments for system-wide proxy configuration: XFCE and LXDE are now supported when [xfce-proxy-gui](https://github.com/AKotov-dev/xfce-proxy-gui) is installed.
22=
23=The list of supported DEs for system-wide proxy has been expanded: XFCE and LXDE have been added if  is installed on the system.
24=
25=V2.5
26=+ Recompiling to Lazarus-3.6
27=+ VMESS/VLESS `HTTPUpgrade` support
28=+ Packages for Mageia-9 and Ubuntu
29=
30=v2.4
31=+ XHTTP support
32=+ Fix xhttpSettings: hostname/host
33=+ Packages for Mageia-9 and Ubuntu
